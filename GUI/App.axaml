<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ADSecurityAuditGUI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#141414"/>
        <SolidColorBrush x:Key="AppSurface" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AppBorder" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="AppText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppMuted" Color="#9D9D9D"/>
        <SolidColorBrush x:Key="AppSubtle" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF"/>
        <SolidColorBrush x:Key="AppAccentDeepBrush" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="AppInputBg" Color="#2C2C2C"/>
        <FontFamily x:Key="AppFont">Inter, Segoe UI Variable Display, Segoe UI, Ubuntu, Cantarell, Noto Sans, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Normal">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#FF60CDFF"
                                       RegionColor="#FF141414"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="{StaticResource AppBg}"/>
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
        </Style>

        <Style Selector="TextBlock.kicker">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AppSubtle}"/>
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AppMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.card-desc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource AppMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource AppInputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppAccentBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}"/>
        </Style>
        <Style Selector="TextBox.log">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0F6CBD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#115EA3"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0F548C"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="#107C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0E6E0E"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#A12616"/>
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="Button.neutral">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="{StaticResource AppText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.neutral:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="#335A73"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15222C"/>
        </Style>

        <Style Selector="Button.textlink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.textlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15222C"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource AppSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="Border.module-card">
            <Setter Property="Background" Value="{StaticResource AppSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="148"/>
        </Style>
        <Style Selector="Border.module-card:pointerover">
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="Background" Value="#252525"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource AppAccentDeepBrush}"/>
            <Setter Property="Background" Value="#2C2C2C"/>
        </Style>
    </Application.Styles>
</Application>
